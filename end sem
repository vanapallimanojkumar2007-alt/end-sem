import { useEffect, useMemo, useState } from 'react'

const money = (value) => new Intl.NumberFormat('en-IN', {
  style: 'currency', currency: 'INR', maximumFractionDigits: 0
}).format(Number(value) || 0)

const starterTransactions = [
  { id: 1, title: 'Monthly salary', amount: 28000, type: 'income', category: 'Salary', date: new Date().toISOString().slice(0, 10), note: 'Monthly income' },
  { id: 2, title: 'Groceries', amount: 1850, type: 'expense', category: 'Food', date: new Date().toISOString().slice(0, 10), note: '' },
  { id: 3, title: 'Bus pass', amount: 650, type: 'expense', category: 'Transport', date: new Date().toISOString().slice(0, 10), note: '' },
  { id: 4, title: 'Freelance work', amount: 3500, type: 'income', category: 'Other income', date: new Date().toISOString().slice(0, 10), note: '' },
]

const categories = {
  expense: ['Food', 'Transport', 'Shopping', 'Education', 'Bills', 'Health', 'Entertainment', 'Other'],
  income: ['Salary', 'Business', 'Freelance', 'Gift', 'Other income'],
}

function readStorage(key, fallback) {
  try {
    const value = localStorage.getItem(key)
    return value ? JSON.parse(value) : fallback
  } catch {
    return fallback
  }
}

function App() {
  const [user, setUser] = useState(() => readStorage('pennywise-user', null))
  const [users, setUsers] = useState(() => readStorage('pennywise-users', []))
  const [transactions, setTransactions] = useState(() => readStorage('pennywise-transactions', starterTransactions))
  const [budgets, setBudgets] = useState(() => readStorage('pennywise-budgets', { Food: 5000, Transport: 2000, Shopping: 3000, Education: 3000 }))
  const [activePage, setActivePage] = useState('Dashboard')
  const [showForm, setShowForm] = useState(false)
  const [editing, setEditing] = useState(null)
  const [filter, setFilter] = useState('All')
  const [search, setSearch] = useState('')
  const [month, setMonth] = useState(new Date().toISOString().slice(0, 7))
  const [authMode, setAuthMode] = useState('login')
  const [authError, setAuthError] = useState('')

  useEffect(() => localStorage.setItem('pennywise-user', JSON.stringify(user)), [user])
  useEffect(() => localStorage.setItem('pennywise-users', JSON.stringify(users)), [users])
  useEffect(() => localStorage.setItem('pennywise-transactions', JSON.stringify(transactions)), [transactions])
  useEffect(() => localStorage.setItem('pennywise-budgets', JSON.stringify(budgets)), [budgets])

  const monthTransactions = useMemo(
    () => transactions.filter(t => t.date?.startsWith(month)),
    [transactions, month]
  )
  const income = monthTransactions.filter(t => t.type === 'income').reduce((s, t) => s + Number(t.amount), 0)
  const expenses = monthTransactions.filter(t => t.type === 'expense').reduce((s, t) => s + Number(t.amount), 0)
  const balance = income - expenses

  const filteredTransactions = useMemo(() => transactions
    .filter(t => filter === 'All' || t.type === filter.toLowerCase())
    .filter(t => `${t.title} ${t.category} ${t.note || ''}`.toLowerCase().includes(search.toLowerCase()))
    .sort((a, b) => b.date.localeCompare(a.date)), [transactions, filter, search])

  const expenseByCategory = useMemo(() => {
    const result = {}
    monthTransactions.filter(t => t.type === 'expense').forEach(t => {
      result[t.category] = (result[t.category] || 0) + Number(t.amount)
    })
    return Object.entries(result).sort((a, b) => b[1] - a[1])
  }, [monthTransactions])

  function handleAuth(e) {
    e.preventDefault()
    const data = new FormData(e.currentTarget)
    const name = String(data.get('name') || '').trim()
    const email = String(data.get('email') || '').trim().toLowerCase()
    const password = String(data.get('password') || '')
    if (!email || password.length < 4) {
      setAuthError('Enter a valid email and a password with at least 4 characters.')
      return
    }
    if (authMode === 'signup') {
      if (!name) return setAuthError('Please enter your name.')
      if (users.some(u => u.email === email)) return setAuthError('An account with this email already exists.')
      const newUser = { name, email, password }
      setUsers(prev => [...prev, newUser])
      setUser({ name, email })
    } else {
      const found = users.find(u => u.email === email && u.password === password)
      if (!found) return setAuthError('Account not found. Check your details or create an account.')
      setUser({ name: found.name, email: found.email })
    }
    setAuthError('')
  }

  function saveTransaction(e) {
    e.preventDefault()
    const data = new FormData(e.currentTarget)
    const item = {
      id: editing?.id || Date.now(),
      title: String(data.get('title')).trim(),
      amount: Number(data.get('amount')),
      type: data.get('type'),
      category: data.get('category'),
      date: data.get('date'),
      note: String(data.get('note') || '').trim(),
    }
    if (!item.title || item.amount <= 0 || !item.date) return
    setTransactions(prev => editing ? prev.map(t => t.id === editing.id ? item : t) : [item, ...prev])
    setShowForm(false)
    setEditing(null)
  }

  function deleteTransaction(id) {
    if (window.confirm('Delete this transaction?')) setTransactions(prev => prev.filter(t => t.id !== id))
  }

  function exportCSV() {
    const rows = [['Date', 'Title', 'Type', 'Category', 'Amount', 'Note'], ...filteredTransactions.map(t => [t.date, t.title, t.type, t.category, t.amount, t.note || ''])]
    const csv = rows.map(row => row.map(value => `"${String(value).replaceAll('"', '""')}"`).join(',')).join('\\n')
    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }))
    const link = document.createElement('a')
    link.href = url
    link.download = 'expense-transactions.csv'
    link.click()
    URL.revokeObjectURL(url)
  }

  function updateBudget(category, value) {
    setBudgets(prev => ({ ...prev, [category]: Math.max(0, Number(value) || 0) }))
  }

  if (!user) {
    return <div className="auth-shell">
      <div className="auth-art">
        <div className="brand light"><span className="brand-mark">₹</span> Pennywise</div>
        <div className="art-copy">
          <span className="eyebrow">YOUR MONEY, IN CONTROL</span>
          <h1>Make every<br />rupee count.</h1>
          <p>Understand your spending, plan your budget, and build better money habits.</p>
          <div className="art-stats"><div><strong>Track</strong><small>Every transaction</small></div><div><strong>Plan</strong><small>Monthly budgets</small></div><div><strong>Grow</strong><small>Better habits</small></div></div>
        </div>
        <div className="art-orb orb-one"></div><div className="art-orb orb-two"></div>
      </div>
      <div className="auth-panel">
        <div className="auth-card">
          <div className="brand dark"><span className="brand-mark">₹</span> Pennywise</div>
          <span className="eyebrow">WELCOME</span>
          <h2>{authMode === 'login' ? 'Welcome back' : 'Create your account'}</h2>
          <p className="muted">{authMode === 'login' ? 'Sign in to continue to your dashboard.' : 'Start organizing your finances today.'}</p>
          <form onSubmit={handleAuth} className="form-stack">
            {authMode === 'signup' && <label>Full name<input name="name" placeholder="Your name" required /></label>}
            <label>Email address<input name="email" type="email" placeholder="you@example.com" required /></label>
            <label>Password<input name="password" type="password" placeholder="At least 4 characters" minLength="4" required /></label>
            {authError && <p className="error">{authError}</p>}
            <button className="primary full" type="submit">{authMode === 'login' ? 'Sign in' : 'Create account'}</button>
          </form>
          <p className="switch-auth">{authMode === 'login' ? "Don't have an account?" : 'Already have an account?'} <button onClick={() => { setAuthMode(authMode === 'login' ? 'signup' : 'login'); setAuthError('') }}>{authMode === 'login' ? 'Sign up' : 'Sign in'}</button></p>
          <p className="auth-note">Demo project · Data is stored in this browser only</p>
        </div>
      </div>
    </div>
  }

  const navItems = [
    { label: 'Dashboard', icon: '▦' },
    { label: 'Transactions', icon: '⇄' },
    { label: 'Budgets', icon: '◎' },
    { label: 'Reports', icon: '▥' },
  ]

  return <div className="app-shell">
    <aside className="sidebar">
      <div className="brand"><span className="brand-mark">₹</span> Pennywise</div>
      <div className="side-label">WORKSPACE</div>
      <nav>{navItems.map(item => <button key={item.label} className={`nav-item ${activePage === item.label ? 'active' : ''}`} onClick={() => setActivePage(item.label)}><span>{item.icon}</span>{item.label}</button>)}</nav>
      <div className="sidebar-bottom">
        <div className="help-card"><span className="help-icon">✦</span><strong>Small steps add up.</strong><p>Keep tracking to build a clearer picture of your money.</p></div>
        <div className="profile"><div className="avatar">{user.name?.charAt(0).toUpperCase()}</div><div className="profile-info"><strong>{user.name}</strong><small>{user.email}</small></div><button className="logout" title="Log out" onClick={() => setUser(null)}>↪</button></div>
      </div>
    </aside>

    <main className="main-area">
      <header className="topbar"><div><span className="eyebrow">PERSONAL FINANCE</span><h1>{activePage}</h1></div><div className="top-actions"><label className="month-picker">Month <input type="month" value={month} onChange={e => setMonth(e.target.value)} /></label><button className="primary" onClick={() => { setEditing(null); setShowForm(true) }}>＋ Add transaction</button></div></header>

      {activePage === 'Dashboard' && <>
        <section className="welcome-row"><div><h2>Good day, {user.name.split(' ')[0]} 👋</h2><p>Here’s your financial snapshot for {new Date(`${month}-02`).toLocaleDateString('en-IN', { month: 'long', year: 'numeric' })}.</p></div><span className="live-tag"><i></i> Your overview</span></section>
        <section className="summary-grid">
          <div className="summary-card balance-card"><div className="card-top"><span>Total balance</span><span className="metric-icon">₹</span></div><strong>{money(balance)}</strong><small>Income minus expenses this month</small><div className="balance-decoration">₹</div></div>
          <div className="summary-card"><div className="card-top"><span>Total income</span><span className="metric-icon green">↗</span></div><strong>{money(income)}</strong><small className="positive">↑ Money received this month</small></div>
          <div className="summary-card"><div className="card-top"><span>Total expenses</span><span className="metric-icon coral">↘</span></div><strong>{money(expenses)}</strong><small className="negative">↓ Money spent this month</small></div>
        </section>
        <section className="content-grid">
          <div className="panel spending-panel"><div className="panel-heading"><div><h3>Spending breakdown</h3><p>Where your money went this month</p></div><button className="text-button" onClick={() => setActivePage('Reports')}>View report →</button></div>
            {expenseByCategory.length ? <div className="breakdown-list">{expenseByCategory.map(([cat, amount], i) => <div className="breakdown-item" key={cat}><div className="breakdown-label"><span className={`category-dot dot-${i % 5}`}></span><span>{cat}</span><strong>{money(amount)}</strong></div><div className="progress-track"><div className={`progress-fill fill-${i % 5}`} style={{ width: `${expenses ? Math.min(100, amount / expenses * 100) : 0}%` }} /></div></div>)}</div> : <div className="empty-state">No expenses recorded for this month yet.</div>}
          </div>
          <div className="panel budget-panel"><div className="panel-heading"><div><h3>Budget overview</h3><p>Monthly category limits</p></div><button className="text-button" onClick={() => setActivePage('Budgets')}>Manage →</button></div>
            {Object.entries(budgets).slice(0, 4).map(([cat, limit]) => { const spent = expenseByCategory.find(x => x[0] === cat)?.[1] || 0; const pct = limit ? Math.min(100, spent / limit * 100) : 0; return <div className="budget-line" key={cat}><div><span>{cat}</span><small>{money(spent)} / {money(limit)}</small></div><div className="progress-track"><div className={`progress-fill ${pct >= 100 ? 'over-budget' : ''}`} style={{ width: `${pct}%` }} /></div></div> })}
          </div>
        </section>
        <section className="panel recent-panel"><div className="panel-heading"><div><h3>Recent transactions</h3><p>Your latest money activity</p></div><button className="text-button" onClick={() => setActivePage('Transactions')}>See all →</button></div><TransactionTable items={transactions.slice().sort((a,b) => b.date.localeCompare(a.date)).slice(0, 5)} onEdit={item => { setEditing(item); setShowForm(true) }} onDelete={deleteTransaction} /></section>
      </>}

      {activePage === 'Transactions' && <section className="panel page-panel"><div className="panel-heading"><div><h3>All transactions</h3><p>Search, review, and manage your activity</p></div><button className="secondary" onClick={exportCSV}>↓ Export CSV</button></div><div className="toolbar"><input className="search-input" placeholder="Search transactions..." value={search} onChange={e => setSearch(e.target.value)} /><div className="filter-tabs">{['All', 'Income', 'Expense'].map(f => <button className={filter === f ? 'selected' : ''} key={f} onClick={() => setFilter(f)}>{f}</button>)}</div></div><TransactionTable items={filteredTransactions} onEdit={item => { setEditing(item); setShowForm(true) }} onDelete={deleteTransaction} /></section>}

      {activePage === 'Budgets' && <section className="panel page-panel"><div className="panel-heading"><div><h3>Monthly budgets</h3><p>Set a spending limit for each category</p></div></div><div className="budget-editor">{[...new Set([...categories.expense, ...Object.keys(budgets)])].map((cat, i) => { const spent = expenseByCategory.find(x => x[0] === cat)?.[1] || 0; const limit = budgets[cat] || 0; const pct = limit ? spent / limit * 100 : 0; return <div className="budget-edit-card" key={cat}><div className="budget-edit-top"><div><span className={`category-dot dot-${i % 5}`}></span><strong>{cat}</strong></div><span className={pct > 100 ? 'over-text' : 'muted'}>{limit && pct >= 100 ? 'Over budget' : `${Math.round(pct)}% used`}</span></div><div className="budget-amounts"><strong>{money(spent)}</strong><small>spent of {money(limit)}</small></div><div className="progress-track"><div className={`progress-fill ${pct > 100 ? 'over-budget' : ''}`} style={{ width: `${Math.min(100, pct)}%` }} /></div><label className="budget-input-label">Monthly limit<input type="number" min="0" value={limit} onChange={e => updateBudget(cat, e.target.value)} placeholder="Enter amount" /></label></div> })}</div></section>}

      {activePage === 'Reports' && <section className="report-layout"><div className="panel report-main"><div className="panel-heading"><div><h3>Income vs expenses</h3><p>Monthly financial summary</p></div></div><div className="report-total"><div><small>Income</small><strong className="positive">{money(income)}</strong></div><div><small>Expenses</small><strong className="negative">{money(expenses)}</strong></div><div><small>Net balance</small><strong>{money(balance)}</strong></div></div><div className="comparison-bars"><div className="bar-group"><div className="bar income-bar" style={{ height: `${Math.max(4, income / Math.max(income, expenses, 1) * 170)}px` }}></div><span>Income</span></div><div className="bar-group"><div className="bar expense-bar" style={{ height: `${Math.max(4, expenses / Math.max(income, expenses, 1) * 170)}px` }}></div><span>Expenses</span></div></div></div><div className="panel report-categories"><div className="panel-heading"><div><h3>Category report</h3><p>Expense distribution this month</p></div></div>{expenseByCategory.length ? expenseByCategory.map(([cat, amount], i) => <div className="report-category" key={cat}><div><span className={`category-dot dot-${i % 5}`}></span>{cat}</div><strong>{money(amount)}</strong></div>) : <div className="empty-state">No expense data available.</div>}</div></section>}
    </main>

    {showForm && <div className="modal-backdrop" onMouseDown={e => { if (e.target === e.currentTarget) { setShowForm(false); setEditing(null) } }}><div className="modal"><div className="modal-heading"><div><span className="eyebrow">{editing ? 'UPDATE RECORD' : 'NEW RECORD'}</span><h2>{editing ? 'Edit transaction' : 'Add transaction'}</h2></div><button className="close-button" onClick={() => { setShowForm(false); setEditing(null) }}>×</button></div><form className="form-stack" onSubmit={saveTransaction}><label>Transaction title<input name="title" placeholder="e.g. Grocery shopping" defaultValue={editing?.title || ''} required /></label><div className="form-two"><label>Amount (₹)<input name="amount" type="number" min="1" step="0.01" placeholder="0.00" defaultValue={editing?.amount || ''} required /></label><label>Date<input name="date" type="date" defaultValue={editing?.date || new Date().toISOString().slice(0,10)} required /></label></div><label>Type<select name="type" defaultValue={editing?.type || 'expense'} onChange={e => { const select = e.currentTarget.form.elements.category; const opts = categories[e.target.value]; select.innerHTML = opts.map(v => `<option>${v}</option>`).join('') }}><option value="expense">Expense</option><option value="income">Income</option></select></label><label>Category<select name="category" defaultValue={editing?.category || 'Food'}>{categories[editing?.type || 'expense'].map(c => <option key={c}>{c}</option>)}</select></label><label>Note (optional)<textarea name="note" rows="2" placeholder="Add a short note..." defaultValue={editing?.note || ''} /></label><div className="modal-actions"><button type="button" className="secondary" onClick={() => { setShowForm(false); setEditing(null) }}>Cancel</button><button type="submit" className="primary">{editing ? 'Save changes' : 'Add transaction'}</button></div></form></div></div>}
  </div>
}

function TransactionTable({ items, onEdit, onDelete }) {
  if (!items.length) return <div className="empty-state">No transactions found. Add your first transaction to get started.</div>
  return <div className="table-wrap"><table><thead><tr><th>TRANSACTION</th><th>CATEGORY</th><th>DATE</th><th>AMOUNT</th><th>ACTIONS</th></tr></thead><tbody>{items.map(t => <tr key={t.id}><td><div className="transaction-name"><span className={`transaction-symbol ${t.type}`}>{t.type === 'income' ? '↙' : '↗'}</span><div><strong>{t.title}</strong><small>{t.note || (t.type === 'income' ? 'Income' : 'Expense')}</small></div></div></td><td><span className="category-pill">{t.category}</span></td><td>{new Date(`${t.date}T00:00:00`).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</td><td className={t.type === 'income' ? 'amount-income' : 'amount-expense'}>{t.type === 'income' ? '+' : '−'}{money(t.amount)}</td><td><div className="row-actions"><button title="Edit" onClick={() => onEdit(t)}>✎</button><button title="Delete" onClick={() => onDelete(t.id)}>⌫</button></div></td></tr>)}</tbody></table></div>
}

export default App
